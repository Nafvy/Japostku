rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerUser() {
      return isVerifiedUser() && request.auth.token.email == 'paundraoktar@gmail.com';
    }

    function isUser(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isOwnerUser() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'isOwner', 'isVerified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'isOwner', 'isVerified', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && data.isOwner is bool
        && data.isVerified is bool
        && (isOwnerUser() || (data.isOwner == false && data.isVerified == false))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'whatsapp', 'isBanned', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'whatsapp', 'isBanned', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.whatsapp is string
        && data.whatsapp.size() <= 20
        && data.isBanned is bool
        && (isAdmin() || data.isBanned == false)
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.role in ['admin', 'moderator']
        && data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId', 'sellerName', 'authorIsOwner', 'authorVerified',
          'isPinned', 'title', 'description', 'priceIdr', 'category',
          'images', 'contactWhatsapp', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'sellerName', 'authorIsOwner', 'authorVerified',
          'isPinned', 'title', 'description', 'priceIdr', 'category',
          'images', 'contactWhatsapp', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.sellerName is string
        && data.sellerName.size() >= 2
        && data.sellerName.size() <= 50
        && data.authorIsOwner is bool
        && data.authorVerified is bool
        && data.isPinned is bool
        && (isOwnerUser() || (data.authorIsOwner == false && data.authorVerified == false && data.isPinned == false))
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 2000
        && data.priceIdr is int
        && data.priceIdr >= 0
        && data.priceIdr <= 999999999999
        && data.category in ['elektronik', 'kendaraan', 'properti', 'fashion', 'rumah_tangga', 'hobi', 'jasa', 'lainnya']
        && data.images is list
        && data.images.size() >= 1
        && data.images.size() <= 5
        && data.images[0] is string
        && data.images[0].size() >= 1
        && data.images[0].size() <= 300
        && data.contactWhatsapp is string
        && data.contactWhatsapp.size() >= 9
        && data.contactWhatsapp.size() <= 20
        && data.contactWhatsapp.matches('^62[0-9]{8,13}$')
        && data.status in ['active', 'sold']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardSetting(data) {
      return data.keys().hasAll(['ownerNotice', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['ownerNotice', 'updatedBy', 'updatedAt'])
        && data.ownerNotice is string
        && data.ownerNotice.size() <= 200
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'actorName', 'action', 'targetType', 'targetId', 'targetLabel', 'createdAt'])
        && data.keys().hasOnly(['actorId', 'actorName', 'action', 'targetType', 'targetId', 'targetLabel', 'reason', 'createdAt'])
        && isValidId(data.actorId)
        && data.actorName is string
        && data.actorName.size() >= 2
        && data.actorName.size() <= 50
        && data.action in ['ban', 'unban', 'role_add', 'role_remove', 'post_delete', 'post_pin', 'post_unpin', 'notice_update']
        && data.targetType in ['user', 'post', 'setting']
        && data.targetId is string
        && data.targetId.size() >= 1
        && data.targetId.size() <= 128
        && data.targetLabel is string
        && data.targetLabel.size() >= 1
        && data.targetLabel.size() <= 200
        && (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 300))
        && data.createdAt is timestamp;
    }

    // Connection check path
    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isOwnerUser();
      allow create: if isUser(userId)
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isUser(userId)
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'isOwner', 'isVerified', 'updatedAt']);
      allow delete: if isOwnerUser() && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isUser(userId) || isAdmin());
        allow list: if isValidId(userId) && (isUser(userId) || isOwnerUser());
        allow create: if isValidId(userId)
          && docId == 'info'
          && isUser(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'info'
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (
            (isUser(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'whatsapp', 'updatedAt']))
            || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isBanned', 'updatedAt']))
          );
        allow delete: if isOwnerUser() && isValidId(userId) && isValidId(docId);
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isUser(userId) || isAdmin());
      allow list: if isOwnerUser();
      allow create: if isOwnerUser()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if isOwnerUser()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email']);
      allow delete: if isOwnerUser() && isValidId(userId);
    }

    match /posts/{postId} {
      allow get: if isValidId(postId);
      allow list: if resource.data.status == 'active'
        || (isSignedIn() && (resource.data.authorId == request.auth.uid || isOwnerUser()));
      allow create: if isVerifiedUser()
        && isValidId(postId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isOwnerUser()
          || (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'priceIdr', 'category', 'images', 'contactWhatsapp', 'status', 'sellerName', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(postId)
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isOwnerUser()
        && settingId == 'board'
        && isValidBoardSetting(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isOwnerUser();
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
